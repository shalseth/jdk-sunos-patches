+// The constants below reflect the barrier in barrierSetAssembler_sparc.cpp.
+static const int entry_barrier_bytes = 11 * BytesPerInstWord;
+static const int entry_barrier_guard_offset = 10 * BytesPerInstWord;
+
+static int* guard_addr(nmethod* nm) {
+  address barrier = nm->code_begin() + nm->frame_complete_offset() - entry_barrier_bytes;
+  assert(Assembler::is_rdpc(*(int*)barrier), "entry barrier must start with rdpc");
+  return reinterpret_cast<int*>(barrier + entry_barrier_guard_offset);
+}
+
+// The method_entry_barrier stub unwinds the nmethod frame itself when the
+// barrier says the nmethod may not be entered.
