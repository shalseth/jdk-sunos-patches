+
+// Emitted right after the frame is pushed, immediately before the frame
+// complete offset: the locals are free and the incoming arguments are still
+// in %i0-%i5 and F0-F7. The guard word is the last word of the barrier, see
+// barrierSetNMethod_sparc.cpp.
+void BarrierSetAssembler::nmethod_entry_barrier(MacroAssembler* masm) {
+  BarrierSetNMethod* bs_nm = BarrierSet::barrier_set()->barrier_set_nmethod();
+  if (bs_nm == nullptr) {
+    return;
+  }
+  assert(StubRoutines::method_entry_barrier() != nullptr, "must be generated before");
+
+  Label skip;
+  address start = __ pc();
+
+  __ rdpc(L0);
+  __ lduw(L0, 10 * BytesPerInstWord, L0);
+  __ ldx(G2_thread, in_bytes(bs_nm->thread_disarmed_guard_value_offset()), L1);   // uint64_t
+  __ cmp(L0, L1);
+  __ brx(Assembler::equal, false, Assembler::pt, skip);
+  __ delayed()->nop();
+  __ call(StubRoutines::method_entry_barrier(), relocInfo::runtime_call_type);
+  __ delayed()->nop();
+  __ br(Assembler::always, false, Assembler::pt, skip);
+  __ delayed()->nop();
+  __ emit_int32(0);   // guard value
+  __ bind(skip);
+
+  assert(__ pc() - start == 11 * BytesPerInstWord, "entry barrier size changed");
+}
