+        Bindings bindings = getBindings(mt, cDesc, false, options);
+
+        MethodHandle handle = new DowncallLinker(CLinux, bindings.callingSequence).getBoundMethodHandle();
+
+        if (bindings.isInMemoryReturn) {
+            handle = SharedUtils.adaptDowncallForIMR(handle, cDesc, bindings.callingSequence);
+        }
+
+        return handle;
+    }
+
+    public static UpcallStubFactory arrangeUpcall(MethodType mt, FunctionDescriptor cDesc, LinkerOptions options) {
+        Bindings bindings = getBindings(mt, cDesc, true, options);
+
+        final boolean dropReturn = true; /* drop return, since we don't have bindings for it */
+        return SharedUtils.arrangeUpcallHelper(mt, bindings.isInMemoryReturn, dropReturn, CLinux,
+                bindings.callingSequence);
+    }
+
+    private static boolean isInMemoryReturn(Optional<MemoryLayout> returnLayout) {
+        return returnLayout
+            .filter(layout -> layout instanceof GroupLayout && layout.byteSize() > MAX_REGISTER_RETURN_STRUCT_SIZE)
+            .isPresent();
+    }
+
+    // A scalar field of a struct, with its offset from the start of the struct.
+    private record Field(long offset, ValueLayout layout) {}
+
+    // The scalar fields of a struct. Unions and everything inside them count as
+    // integral data (null layout).
+    private static void flatten(MemoryLayout layout, long offset, boolean inUnion, List<Field> fields) {
+        switch (layout) {
+            case UnionLayout ul -> {
+                for (MemoryLayout member : ul.memberLayouts()) {
+                    flatten(member, offset, true, fields);
+                }
+            }
+            case GroupLayout gl -> {
+                long fieldOffset = offset;
+                for (MemoryLayout member : gl.memberLayouts()) {
+                    flatten(member, fieldOffset, inUnion, fields);
+                    fieldOffset += member.byteSize();
+                }
+            }
+            case SequenceLayout sl -> {
+                for (long i = 0; i < sl.elementCount(); i++) {
+                    flatten(sl.elementLayout(), offset + i * sl.elementLayout().byteSize(), inUnion, fields);
+                }
+            }
+            case PaddingLayout _ -> { }
+            case ValueLayout vl -> fields.add(new Field(offset, inUnion ? null : vl));
+            default -> throw new IllegalStateException("Unexpected layout: " + layout);
+        }
+    }
+
+    private static boolean isFloatField(Field f) {
+        return f.layout() != null
+            && (f.layout().carrier() == float.class || f.layout().carrier() == double.class);
+    }
+
+    // One 8-byte word of a struct passed or returned in registers.
+    private record Word(long offset, long size, boolean integral, List<Field> floats) {}
+
+    private static List<Word> words(GroupLayout layout, boolean allIntegral) {
+        List<Field> fields = new ArrayList<>();
+        flatten(layout, 0, false, fields);
+        List<Word> words = new ArrayList<>();
+        for (long offset = 0; offset < layout.byteSize(); offset += STACK_SLOT_SIZE) {
+            long end = offset + STACK_SLOT_SIZE;
+            boolean integral = allIntegral;
+            List<Field> floats = new ArrayList<>();
+            for (Field f : fields) {
+                if (f.offset() < offset || f.offset() >= end) {
+                    continue;
+                }
+                if (!allIntegral && isFloatField(f)) {
+                    floats.add(f);
+                } else {
+                    integral = true;
+                }
+            }
+            if (floats.isEmpty()) {
+                integral = true; // padding only
+            }
+            words.add(new Word(offset, Math.min(STACK_SLOT_SIZE, layout.byteSize() - offset), integral, floats));
+        }
+        return words;
+    }
+
+    enum TypeClass {
+        INTEGER,
+        FLOAT,
+        POINTER,
+        STRUCT_REGISTER,
+        STRUCT_REFERENCE;
+
+        static TypeClass classify(MemoryLayout layout, boolean forArguments) {
+            if (layout instanceof ValueLayout vl) {
+                if (vl instanceof AddressLayout) {
+                    return POINTER;
+                }
+                Class<?> carrier = vl.carrier();
+                if (carrier == float.class || carrier == double.class) {
+                    return FLOAT;
+                }
+                return INTEGER;
+            } else if (layout instanceof GroupLayout) {
+                long limit = forArguments ? MAX_REGISTER_ARGUMENT_STRUCT_SIZE : MAX_REGISTER_RETURN_STRUCT_SIZE;
+                return layout.byteSize() <= limit ? STRUCT_REGISTER : STRUCT_REFERENCE;
+            }
+            throw new IllegalArgumentException("Unsupported layout: " + layout);
+        }
+    }
+
+    static class StorageCalculator {
+        private final boolean forArguments;
+        private int slot = 0;
+
+        StorageCalculator(boolean forArguments) {
+            this.forArguments = forArguments;
+        }
+
+        // The next argument slot, or the word index of a return value.
+        int nextSlot() {
+            return slot++;
+        }
+
+        static VMStorage stackSlot(int slot, int size, int offsetInSlot) {
+            assert slot >= MAX_INT_REGISTER_SLOTS;
+            return stackStorage((short) size, (slot - MAX_INT_REGISTER_SLOTS) * STACK_SLOT_SIZE + offsetInSlot);
+        }
+
+        VMStorage integral(int slot) {
+            if (slot < MAX_INT_REGISTER_SLOTS) {
+                return INT_ARG_REGS[slot];
+            }
+            if (!forArguments) {
+                throw new IllegalStateException("Return value does not fit in registers");
+            }
+            return stackSlot(slot, 8, 0);
+        }
+
+        // a scalar float or double argument / return value
+        VMStorage floating(int slot, boolean isFloat) {
+            if (!forArguments) {
+                return isFloat ? single(f(0)) : f(0);
+            }
+            if (slot < MAX_FLOAT_REGISTER_SLOTS) {
+                return isFloat ? single(f(2 * slot + 1)) : f(2 * slot);
+            }
+            return isFloat ? stackSlot(slot, 4, 4) : stackSlot(slot, 8, 0);
+        }
+
+        // a float or double field of a struct word, or null if the word is not
+        // in floating point registers
+        VMStorage structFloat(int slot, long offsetInWord, boolean isFloat) {
+            if (forArguments && slot >= MAX_FLOAT_REGISTER_SLOTS) {
+                return null;
+            }
+            int reg = 2 * slot + (int) (offsetInWord / 4);
+            return isFloat ? single(f(reg)) : f(reg);
+        }
+
+        private static VMStorage single(VMStorage reg) {
+            return new VMStorage(reg.type(), REG32_MASK, reg.indexOrOffset());
+        }
+    }
+
+    abstract static class BindingCalculator {
+        protected final StorageCalculator storageCalculator;
+
+        protected BindingCalculator(boolean forArguments) {
+            this.storageCalculator = new StorageCalculator(forArguments);
+        }
+
+        abstract List<Binding> getBindings(Class<?> carrier, MemoryLayout layout, boolean variadic);
+    }
+
+    // Compute recipe for transferring arguments / return values to C from Java.
+    static class UnboxBindingCalculator extends BindingCalculator {
+        private final boolean forArguments;
+        private final boolean useAddressPairs;
+
+        UnboxBindingCalculator(boolean forArguments, boolean useAddressPairs) {
+            super(forArguments);
+            this.forArguments = forArguments;
+            this.useAddressPairs = useAddressPairs;
+        }
+
+        @Override
+        List<Binding> getBindings(Class<?> carrier, MemoryLayout layout, boolean variadic) {
+            TypeClass argumentClass = TypeClass.classify(layout, forArguments);
+            Binding.Builder bindings = Binding.builder();
+            switch (argumentClass) {
+                case STRUCT_REGISTER -> {
+                    assert carrier == MemorySegment.class;
+                    List<Word> words = words((GroupLayout) layout, variadic);
+                    int firstSlot = storageCalculator.slot;
+                    storageCalculator.slot += words.size();
+                    // one binding chain per register, each starting from a copy of the segment
+                    List<Runnable> moves = new ArrayList<>();
+                    for (int w = 0; w < words.size(); w++) {
+                        Word word = words.get(w);
+                        int slot = firstSlot + w;
+                        List<VMStorage> floatRegs = new ArrayList<>();
+                        for (Field f : word.floats()) {
+                            floatRegs.add(storageCalculator.structFloat(slot, f.offset() - word.offset(), f.layout().carrier() == float.class));
+                        }
+                        boolean inFloatRegs = !word.floats().isEmpty() && floatRegs.get(0) != null;
+                        if (word.integral() || !inFloatRegs) {
+                            VMStorage storage = storageCalculator.integral(slot);
+                            moves.add(() -> unboxWord(bindings, word, storage));
+                        }
+                        if (inFloatRegs) {
+                            for (int k = 0; k < word.floats().size(); k++) {
+                                Field f = word.floats().get(k);
+                                VMStorage storage = floatRegs.get(k);
+                                moves.add(() -> {
+                                    Class<?> type = f.layout().carrier();
+                                    bindings.bufferLoad(f.offset(), type)
+                                            .vmStore(storage, type);
+                                });
+                            }
+                        }
+                    }
+                    for (int m = 0; m < moves.size(); m++) {
+                        if (m < moves.size() - 1) {
+                            bindings.dup();
+                        }
+                        moves.get(m).run();
+                    }
+                }
+                case STRUCT_REFERENCE -> {
+                    assert carrier == MemorySegment.class;
+                    bindings.copy(layout)
+                            .unboxAddress();
+                    VMStorage storage = storageCalculator.integral(storageCalculator.nextSlot());
+                    bindings.vmStore(storage, long.class);
+                }
+                case POINTER -> {
+                    VMStorage storage = storageCalculator.integral(storageCalculator.nextSlot());
+                    if (useAddressPairs) {
+                        bindings.dup()
+                                .segmentBase()
+                                .vmStore(storage, Object.class)
+                                .segmentOffsetAllowHeap()
+                                .vmStore(null, long.class);
+                    } else {
+                        bindings.unboxAddress();
+                        bindings.vmStore(storage, long.class);
+                    }
+                }
+                case INTEGER -> {
+                    // ABI requires all int types to get extended to 64 bit.
+                    VMStorage storage = storageCalculator.integral(storageCalculator.nextSlot());
+                    bindings.vmStore(storage, carrier);
+                }
+                case FLOAT -> {
+                    int slot = storageCalculator.nextSlot();
+                    VMStorage storage = variadic
+                        ? storageCalculator.integral(slot)
+                        : storageCalculator.floating(slot, carrier == float.class);
+                    bindings.vmStore(storage, carrier);
+                }
+                default -> throw new UnsupportedOperationException("Unhandled class " + argumentClass);
+            }
+            return bindings.build();
+        }
+
+        // The word in its integer register or stack slot; a partial last word
+        // is left-justified.
+        private static void unboxWord(Binding.Builder bindings, Word word, VMStorage storage) {
+            int size = (int) word.size();
+            Class<?> type = SharedUtils.primitiveCarrierForSize(size, false);
+            bindings.bufferLoad(word.offset(), type, size);
+            if (size < STACK_SLOT_SIZE) {
+                bindings.shiftLeft(STACK_SLOT_SIZE - size, type)
+                        .vmStore(storage, long.class);
+            } else {
+                bindings.vmStore(storage, type);
+            }
+        }
+    }
+
+    // Compute recipe for transferring arguments / return values from C to Java.
+    static class BoxBindingCalculator extends BindingCalculator {
+        private final boolean forArguments;
+
+        BoxBindingCalculator(boolean forArguments) {
+            super(forArguments);
+            this.forArguments = forArguments;
+        }
+
+        @Override
+        List<Binding> getBindings(Class<?> carrier, MemoryLayout layout, boolean variadic) {
+            TypeClass argumentClass = TypeClass.classify(layout, forArguments);
+            Binding.Builder bindings = Binding.builder();
+            switch (argumentClass) {
+                case STRUCT_REGISTER -> {
+                    assert carrier == MemorySegment.class;
+                    bindings.allocate(layout);
+                    List<Word> words = words((GroupLayout) layout, variadic);
+                    int firstSlot = storageCalculator.slot;
+                    storageCalculator.slot += words.size();
+                    for (int w = 0; w < words.size(); w++) {
+                        Word word = words.get(w);
+                        int slot = firstSlot + w;
+                        List<VMStorage> floatRegs = new ArrayList<>();
+                        for (Field f : word.floats()) {
+                            floatRegs.add(storageCalculator.structFloat(slot, f.offset() - word.offset(), f.layout().carrier() == float.class));
+                        }
+                        boolean inFloatRegs = !word.floats().isEmpty() && floatRegs.get(0) != null;
+                        // the integral word first: float fields are stored over it
+                        if (word.integral() || !inFloatRegs) {
+                            VMStorage storage = storageCalculator.integral(slot);
+                            int size = (int) word.size();
+                            Class<?> type = SharedUtils.primitiveCarrierForSize(size, false);
+                            bindings.dup();
+                            if (size < STACK_SLOT_SIZE) {
+                                bindings.vmLoad(storage, long.class)
+                                        .shiftRight(STACK_SLOT_SIZE - size, type);
+                            } else {
+                                bindings.vmLoad(storage, type);
+                            }
+                            bindings.bufferStore(word.offset(), type, size);
+                        }
+                        if (inFloatRegs) {
+                            for (int k = 0; k < word.floats().size(); k++) {
+                                Field f = word.floats().get(k);
+                                Class<?> type = f.layout().carrier();
+                                bindings.dup()
+                                        .vmLoad(floatRegs.get(k), type)
+                                        .bufferStore(f.offset(), type);
+                            }
+                        }
+                    }
+                }
+                case STRUCT_REFERENCE -> {
+                    assert carrier == MemorySegment.class;
+                    VMStorage storage = storageCalculator.integral(storageCalculator.nextSlot());
+                    bindings.vmLoad(storage, long.class)
+                            .boxAddress(layout);
+                }
+                case POINTER -> {
+                    AddressLayout addressLayout = (AddressLayout) layout;
+                    VMStorage storage = storageCalculator.integral(storageCalculator.nextSlot());
+                    bindings.vmLoad(storage, long.class)
+                            .boxAddressRaw(Utils.pointeeByteSize(addressLayout), Utils.pointeeByteAlign(addressLayout));
+                }
+                case INTEGER -> {
+                    VMStorage storage = storageCalculator.integral(storageCalculator.nextSlot());
+                    bindings.vmLoad(storage, carrier);
+                }
+                case FLOAT -> {
+                    int slot = storageCalculator.nextSlot();
+                    VMStorage storage = variadic
+                        ? storageCalculator.integral(slot)
+                        : storageCalculator.floating(slot, carrier == float.class);
+                    bindings.vmLoad(storage, carrier);
+                }
+                default -> throw new UnsupportedOperationException("Unhandled class " + argumentClass);
+            }
+            return bindings.build();
+        }
+    }
+}
