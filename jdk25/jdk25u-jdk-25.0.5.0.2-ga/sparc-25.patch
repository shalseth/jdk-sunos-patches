+void InterpreterMacroAssembler::call_VM_preemptable(Register oop_result, address entry_point,
+                                                    Register arg_1, bool check_exceptions) {
+  if (!Continuations::enabled()) {
+    call_VM(oop_result, entry_point, arg_1, check_exceptions);
+    return;
+  }
+  assert(oop_result == noreg, "no result after preemption");
+  Label do_call, done;
+
+  // Resumed here, at the last_Java_pc of the call, after a preemption. Thaw
+  // trims the frame to its expression stack; Llast_SP is the sp of the call.
+  ba_short(do_call);
+  address resume_pc = pc();
+  mov(Llast_SP, SP);
+  ba_short(done);
+
+  bind(do_call);
+  mov(arg_1, O1);
+  mov(SP, Llast_SP);
+  push_cont_fastpath(G3_scratch, G4_scratch);
+  load_emitted_address(resume_pc, G3_scratch);
+  set_last_Java_frame(SP, G3_scratch);
+  save_thread(L7_thread_cache);
+  call(entry_point, relocInfo::runtime_call_type);
+  delayed()->mov(G2_thread, O0);
+  restore_thread(L7_thread_cache);
+  reset_last_Java_frame();
+  jump_if_preempted(G3_scratch);
+  if (check_exceptions) {
+    check_and_forward_exception(Gtemp);
+  }
+  bind(done);
+}
