+
+#define __ _masm->
+
+static void add_sp_offset(MacroAssembler* _masm, int offset, Register d) {
+  int disp = STACK_BIAS + offset;
+  if (Assembler::is_simm13(disp)) {
+    __ add(SP, disp, d);
+  } else {
+    __ set(disp, d);
+    __ add(SP, d, d);
+  }
+}
+
+// The C caller's globals that Java code changes; window registers need no saving.
+static const Register saved_globals[]  = { G2, G3, G4, G6, G7 };
+static const Register global_copies[]  = { L0, L1, L2, L3, L4 };
+
+static const int upcall_stub_code_base_size = 2048;
+static const int upcall_stub_size_per_arg = 64; // arg save & restore + move
 
 address UpcallLinker::make_upcall_stub(jobject receiver, Symbol* signature,
                                        BasicType* out_sig_bt, int total_out_args,
                                        BasicType ret_type,
                                        jobject jabi, jobject jconv,
                                        bool needs_return_buffer, int ret_buf_size) {
-  ShouldNotCallThis();
-  return nullptr;
+  ResourceMark rm;
+  const ABIDescriptor abi = ForeignGlobals::parse_abi_descriptor(jabi);
+  const CallRegs call_regs = ForeignGlobals::parse_call_regs(jconv);
+  int code_size = upcall_stub_code_base_size + (total_out_args * upcall_stub_size_per_arg);
+  CodeBuffer buffer("upcall_stub", code_size, /* locs_size = */ 1);
+  if (buffer.blob() == nullptr) {
+    return nullptr;
+  }
+
+  // The C convention names registers from the caller's side; after the save
+  // the C arguments and results are in %i registers.
+  GrowableArray<VMStorage> c_arg_regs = window_in_regs(call_regs._arg_regs);
+  GrowableArray<VMStorage> c_ret_regs = window_in_regs(call_regs._ret_regs);
+
+  GrowableArray<VMStorage> unfiltered_out_regs;
+  int out_arg_bytes = ForeignGlobals::java_calling_convention(out_sig_bt, total_out_args, unfiltered_out_regs);
+  // Stack arguments of the Java callee sit above our register window save area.
+  const int java_stack_args_bias = frame::register_save_words * wordSize;
+  int out_arg_area = MAX2(java_stack_args_bias + out_arg_bytes, abi._shadow_space_bytes);
+
+  RegSpiller arg_spiller(c_arg_regs);
+  RegSpiller result_spiller(c_ret_regs);
+
+  int res_save_area_offset   = align_up(out_arg_area, 8);
+  int arg_save_area_offset   = res_save_area_offset + result_spiller.spill_size_bytes();
+  int float_save_area_offset = arg_save_area_offset + arg_spiller.spill_size_bytes();
+  int ret_buf_offset         = float_save_area_offset + float_arg_save_bytes;
+  int frame_data_offset      = ret_buf_offset;
+  if (needs_return_buffer) {
+    frame_data_offset += align_up(ret_buf_size, 8);
+  }
+  int frame_bottom_offset    = frame_data_offset + sizeof(UpcallStub::FrameData);
+
+  StubLocations locs;
+  VMStorage shuffle_reg = abi._scratch1;
+  if (needs_return_buffer) {
+    locs.set(StubLocations::RETURN_BUFFER, abi._scratch2);
+  }
+
+  GrowableArray<VMStorage> in_regs = ForeignGlobals::replace_place_holders(c_arg_regs, locs);
+  GrowableArray<VMStorage> filtered_out_regs = window_out_regs(ForeignGlobals::upcall_filter_receiver_reg(unfiltered_out_regs));
+
+  int frame_size = align_up(frame_bottom_offset, StackAlignmentInBytes);
+
+  // The space we have allocated will look like:
+  //
+  //
+  // FP-> |                     |
+  //      |---------------------| = frame_bottom_offset = frame_size
+  //      |                     |
+  //      | FrameData           |
+  //      |---------------------| = frame_data_offset
+  //      | (optional)          |
+  //      | ret_buf             |
+  //      |---------------------| = ret_buf_offset
+  //      | float args          |
+  //      |---------------------| = float_save_area_offset
+  //      | argument save area  |
+  //      |---------------------| = arg_save_area_offset
+  //      | result save area    |
+  //      |---------------------| = res_save_area_offset
+  //      | out args, window    |
+  // SP-> |---------------------|
+
+  //////////////////////////////////////////////////////////////////////////////
+
+  MacroAssembler* _masm = new MacroAssembler(&buffer);
+  address start = __ pc();
+
+  if (Assembler::is_simm13(-frame_size)) {
+    __ save(SP, -frame_size, SP);
+  } else {
+    __ set(-frame_size, G1);
+    __ save(SP, G1, SP);
+  }
+
+  for (size_t i = 0; i < ARRAY_SIZE(saved_globals); i++) {
+    __ mov(saved_globals[i], global_copies[i]);
+  }
+
+  arg_spiller.generate_spill(_masm, arg_save_area_offset);
+
+  __ block_comment("on_entry {");
+  add_sp_offset(_masm, frame_data_offset, O0);
+  __ call(CAST_FROM_FN_PTR(address, UpcallLinker::on_entry), relocInfo::runtime_call_type);
+  __ delayed()->nop();
+  __ mov(O0, G2_thread);
+  __ reinit_heapbase();
+  __ block_comment("} on_entry");
+
+  __ block_comment("argument shuffle {");
+  arg_spiller.generate_fill(_masm, arg_save_area_offset);
+  if (needs_return_buffer) {
+    add_sp_offset(_masm, ret_buf_offset, as_Register(locs.get(StubLocations::RETURN_BUFFER)));
+  }
+  GrowableArray<VMStorage> shuffle_in_regs = save_float_args(_masm, in_regs, float_save_area_offset);
+  ArgumentShuffle arg_shuffle(shuffle_in_regs, filtered_out_regs, shuffle_reg);
+
+#ifndef PRODUCT
+  LogTarget(Trace, foreign, upcall) lt;
+  if (lt.is_enabled()) {
+    LogStream ls(lt);
+    arg_shuffle.print_on(&ls);
+  }
+#endif
+
+  arg_shuffle.generate(_masm, shuffle_reg, abi._shadow_space_bytes, java_stack_args_bias);
+  __ block_comment("} argument shuffle");
+
+  __ block_comment("load_target {");
+  __ set((intptr_t)receiver, O0);
+  __ call(StubRoutines::upcall_stub_load_target(), relocInfo::runtime_call_type); // target Method* in G5_method
+  __ delayed()->nop();
+  __ block_comment("} load_target");
+
+  __ push_cont_fastpath(G3_scratch, G4_scratch);
+
+  __ ld_ptr(G5_method, in_bytes(Method::from_compiled_offset()), G3_scratch);
+  __ jmpl(G3_scratch, 0, O7);
+  __ delayed()->nop();
+
+  __ pop_cont_fastpath(SP, G3_scratch, G4_scratch);
+
+  // return value shuffle
+  if (!needs_return_buffer) {
+    if (call_regs._ret_regs.length() == 1) { // 0 or 1
+      VMStorage ret_reg = c_ret_regs.at(0);
+      switch (ret_type) {
+        case T_BOOLEAN:
+        case T_BYTE:
+        case T_SHORT:
+        case T_CHAR:
+        case T_INT:
+          // C wants ints extended to 64 bits
+          __ sra(O0, 0, as_Register(ret_reg));
+          break;
+        case T_LONG:
+          __ mov(O0, as_Register(ret_reg));
+          break;
+        case T_FLOAT:
+        case T_DOUBLE:
+          assert(as_FloatRegister(ret_reg) == F0, "unexpected result register");
+          break;
+        default:
+          fatal("unexpected return type: %s", type2name(ret_type));
+      }
+    }
+  } else {
+    __ block_comment("return buffer {");
+    add_sp_offset(_masm, ret_buf_offset, G3_scratch);
+    int offset = 0;
+    for (int i = 0; i < c_ret_regs.length(); i++) {
+      VMStorage reg = c_ret_regs.at(i);
+      if (reg.type() == StorageType::INTEGER) {
+        __ ldx(G3_scratch, offset, as_Register(reg));
+      } else if (reg.type() == StorageType::FLOAT) {
+        __ ldf(reg.segment_mask() == REG32_MASK ? FloatRegisterImpl::S : FloatRegisterImpl::D,
+               G3_scratch, offset, as_FloatRegister(reg));
+      } else {
+        ShouldNotReachHere();
+      }
+      offset += 8;
+    }
+    __ block_comment("} return buffer");
+  }
+
+  result_spiller.generate_spill(_masm, res_save_area_offset);
+
+  __ block_comment("on_exit {");
+  add_sp_offset(_masm, frame_data_offset, O0);
+  __ call(CAST_FROM_FN_PTR(address, UpcallLinker::on_exit), relocInfo::runtime_call_type);
+  __ delayed()->nop();
+  __ block_comment("} on_exit");
+
+  result_spiller.generate_fill(_masm, res_save_area_offset);
+
+  for (size_t i = 0; i < ARRAY_SIZE(saved_globals); i++) {
+    __ mov(global_copies[i], saved_globals[i]);
+  }
+
+  __ ret();
+  __ delayed()->restore();
+
+  //////////////////////////////////////////////////////////////////////////////
+
+  _masm->flush();
+
+#ifndef PRODUCT
+  stringStream ss;
+  ss.print("upcall_stub_%s", signature->as_C_string());
+  const char* name = _masm->code_string(ss.as_string());
+#else // PRODUCT
+  const char* name = "upcall_stub";
+#endif // PRODUCT
+
+  buffer.log_section_sizes(name);
+
+  UpcallStub* blob
+    = UpcallStub::create(name,
+                         &buffer,
+                         receiver,
+                         in_ByteSize(frame_data_offset));
+  if (blob == nullptr) {
+    return nullptr;
+  }
+
+#ifndef PRODUCT
+  if (lt.is_enabled()) {
+    LogStream ls(lt);
+    blob->print_on(&ls);
+  }
+#endif
+
+  return blob->code_begin();
 }
