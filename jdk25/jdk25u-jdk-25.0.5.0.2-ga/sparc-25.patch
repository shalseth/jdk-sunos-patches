+  bind(Llast);
+  sub(end, base, t1);
+  sll(t1, 3, t1);
+  mov(64, word);
+  sub(word, t1, t1);
+  mov(-1, word);
+  sllx(word, t1, word);
+  and3(hits, word, hits);
+  cmp_and_brx_short(hits, 0, Assembler::equal, Assembler::pn, Lnot_found);
