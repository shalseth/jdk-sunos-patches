+  // First word: drop the lanes before str.
+  and3(str, 7, t1);
+  sub(str, t1, base);
+  srl(cnt, 0, end);
+  sllx(end, shift, end);
+  add(end, str, end);
+  lane_hits();
+  sll(t1, 3, t1);
+  mov(-1, word);
+  srlx(word, t1, word);
+  and3(hits, word, hits);
+  sub(end, 1, t1);
+  andn(t1, 7, t1);               // the last word
