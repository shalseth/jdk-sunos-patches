+static void check_continuation_enter_argument(VMReg actual_vmreg,
+                                              Register expected_reg,
+                                              const char* name) {
+  assert(!actual_vmreg->is_stack(), "%s cannot be on stack", name);
+  assert(actual_vmreg->as_Register() == expected_reg,
+         "%s is in unexpected register: %s instead of %s",
+         name, actual_vmreg->as_Register()->name(), expected_reg->name());
+}
+
+static void gen_continuation_enter(MacroAssembler* masm,
+                                   const VMRegPair* regs,
+                                   int& exception_offset,
+                                   OopMapSet* oop_maps,
+                                   int& frame_complete,
+                                   int& framesize_words,
+                                   int& interpreted_entry_offset,
+                                   int& compiled_entry_offset) {
+  // enterSpecial(Continuation c, boolean isContinue, boolean isVirtualThread):
+  // the callee's view, the arguments are in I0-I2 after the save
+  check_continuation_enter_argument(regs[0].first(), I0, "Continuation object");
+  check_continuation_enter_argument(regs[1].first(), I1, "isContinue");
+  check_continuation_enter_argument(regs[2].first(), I2, "isVirtualThread");
+
+  const int frame_size_in_bytes = (int)ContinuationEntry::size();
+  assert(is_aligned(frame_size_in_bytes, frame::frame_alignment), "alignment error");
+  framesize_words = frame_size_in_bytes / wordSize;
+
+  address start = __ pc();
+  Label L_thaw, L_exit;
+
+  // i2i entry used at interp_only_mode only
+  interpreted_entry_offset = __ pc() - start;
+  {
+    // Gargs points at the last argument on the expression stack (see call_from_interpreter)
+    __ ld_ptr(Gargs, Interpreter::stackElementSize * 2, O0);
+    __ ld(Gargs, Interpreter::stackElementSize * 1, O1);
+    __ ld(Gargs, 0, O2);
+
+    continuation_enter_setup(masm, frame_size_in_bytes);
+    fill_continuation_entry(masm);
+    __ cmp_and_br_short(I1, 0, Assembler::notEqual, Assembler::pn, L_thaw);
+
+    // Always resolved to the c2i entry of Continuation.enter(Continuation c, boolean isContinue),
+    // see ContinuationEntry::is_interpreted_call
+    __ mov(I0, O0);
+    __ mov(I1, O1);
+    address c2i_call_pc = __ pc();
+    __ call(SharedRuntime::get_resolve_static_call_stub(), relocInfo::static_call_type);
+    __ delayed()->nop();
+    oop_maps->add_gc_map(__ pc() - start, new OopMap(frame_size_in_bytes / VMRegImpl::stack_slot_size, 0));
+    address stub = CompiledDirectCall::emit_to_interp_stub(masm, c2i_call_pc);
+    guarantee(stub != nullptr, "CodeCache is full at gen_continuation_enter");
+    __ ba_short(L_exit);
+  }
+
+  // compiled entry
+  __ align(CodeEntryAlignment);
+  compiled_entry_offset = __ pc() - start;
+
+  continuation_enter_setup(masm, frame_size_in_bytes);
+  frame_complete = __ pc() - start;
+  fill_continuation_entry(masm);
+  __ cmp_and_br_short(I1, 0, Assembler::notEqual, Assembler::pn, L_thaw);
+
+  // The call is resolved through LinkResolver::resolve_continuation_enter()
+  __ mov(I0, O0);
+  __ mov(I1, O1);
+  address call_pc = __ pc();
+  __ call(SharedRuntime::get_resolve_static_call_stub(), relocInfo::static_call_type);
+  __ delayed()->nop();
+  oop_maps->add_gc_map(__ pc() - start, new OopMap(frame_size_in_bytes / VMRegImpl::stack_slot_size, 0));
+  address stub = CompiledDirectCall::emit_to_interp_stub(masm, call_pc);
+  guarantee(stub != nullptr, "CodeCache is full at gen_continuation_enter");
+  __ ba_short(L_exit);
+
+  // --- Thawing path
+
+  __ bind(L_thaw);
+  ContinuationEntry::_thaw_call_pc_offset = __ pc() - start;
+  __ call(StubRoutines::cont_thaw(), relocInfo::runtime_call_type);
+  __ delayed()->nop();
+  oop_maps->add_gc_map(__ pc() - start, new OopMap(frame_size_in_bytes / VMRegImpl::stack_slot_size, 0));
+  ContinuationEntry::_return_pc_offset = __ pc() - start;
+
+  // --- Normal exit (resolve/thawing)
+
+  __ bind(L_exit);
+  ContinuationEntry::_cleanup_offset = __ pc() - start;
+  continuation_enter_cleanup(masm, SP, STACK_BIAS);
+  __ ret();
+  __ delayed()->restore();
+
+  // --- Exception handling path: Oexception, Oissuing_pc
+
+  exception_offset = __ pc() - start;
+  continuation_enter_cleanup(masm, SP, STACK_BIAS);
+  __ mov(Oexception, L4);
+  __ add(I7, frame::pc_return_offset, L5);   // issuing pc in our caller
+  __ call_VM_leaf(L7_thread_cache, CAST_FROM_FN_PTR(address, SharedRuntime::exception_handler_for_return_address), G2_thread, L5);
+  __ mov(O0, G3_scratch);
+  __ mov(L4, I0);   // Oexception after restore
+  __ mov(L5, I1);   // Oissuing_pc after restore
+  __ jmp(G3_scratch, 0);
+  __ delayed()->restore();
+}
+
+static void gen_continuation_yield(MacroAssembler* masm,
+                                   const VMRegPair* regs,
+                                   OopMapSet* oop_maps,
+                                   int& frame_complete,
+                                   int& framesize_words,
+                                   int& compiled_entry_offset) {
+  // A minimal frame: the frozen top frame's pc is found in its I7 slot
+  // (frame::sender_sp_ret_address_offset).
+  const int framesize_bytes = frame::memory_parameter_word_sp_offset * wordSize;
+  framesize_words = framesize_bytes / wordSize;
+
+  address start = __ pc();
+  compiled_entry_offset = __ pc() - start;
+
+  __ save(SP, -framesize_bytes, SP);
+  frame_complete = __ pc() - start;
+  // flushw does not save the current window; freeze walks from this frame
+  __ flushw();
+  __ st_ptr(FP, SP, FP->sp_offset_in_saved_window() * wordSize + STACK_BIAS);
+  __ st_ptr(I7, SP, I7->sp_offset_in_saved_window() * wordSize + STACK_BIAS);
+
+  address the_pc = __ pc();
+  __ call(the_pc + 2 * BytesPerInstWord, relocInfo::none);   // O7 = the_pc
+  __ delayed()->nop();
+  oop_maps->add_gc_map(the_pc - start, new OopMap(framesize_bytes / VMRegImpl::stack_slot_size, 0));
+
+  __ set_last_Java_frame(SP, O7);
+  __ set(JavaFrameAnchor::flushed, G3_scratch);
+  __ st(G3_scratch, G2_thread, in_bytes(JavaThread::frame_anchor_offset() + JavaFrameAnchor::flags_offset()));
+  __ add(SP, STACK_BIAS, L0);
+  __ call_VM_leaf(L7_thread_cache, Continuation::freeze_entry(), G2_thread, L0);
+  __ reset_last_Java_frame();
+
+  Label L_pinned;
+  __ br_notnull_short(O0, Assembler::pn, L_pinned);
+
+  // Frozen: return from enterSpecial to its caller. The continuation's frames
+  // are gone; enterSpecial's fp is the end of the entry.
+  SharedRuntime::continuation_enter_cleanup(masm); // L0: the entry
+  __ add(L0, (int)ContinuationEntry::size() - STACK_BIAS, FP);
+  __ ld_ptr(L0, in_bytes(ContinuationEntryPD::return_pc_offset()), I7);
+  __ flushw();
+  __ ret();
+  __ delayed()->restore();
+
+  __ bind(L_pinned);
+  // Pinned: return the freeze result to doYield's caller
+  __ ret();
+  __ delayed()->restore(O0, G0, O0);
+}
