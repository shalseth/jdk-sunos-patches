+void MacroAssembler::load_emitted_address(address target, Register d) {
+  rdpc(d);
+  intptr_t disp = target - (pc() - BytesPerInstWord);
+  assert(is_simm13(disp), "target too far away");
+  add(d, disp, d);
+}
+
+void MacroAssembler::jump_if_preempted(Register tmp) {
+  Label not_preempted;
+  ld_ptr(G2_thread, in_bytes(JavaThread::preempt_alternate_return_offset()), tmp);
+  br_null_short(tmp, Assembler::pt, not_preempted);
+  st_ptr(G0, G2_thread, in_bytes(JavaThread::preempt_alternate_return_offset()));
+  jmp(tmp, 0);
+  delayed()->nop();
+  bind(not_preempted);
+}
