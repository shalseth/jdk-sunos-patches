+/**
+ * The SPARC V9 (64-bit) C calling convention on Linux.
+ *
+ * Arguments are assigned to consecutive 8-byte slots. Slot j is passed in
+ * %o<j> (j < 6) for integral and pointer values, in %f<2j+1> (float) or %d<2j>
+ * (double) for floating point values (j < 16), and otherwise on the stack at
+ * the slot's place in the parameter array (%sp + BIAS + 128 + 8j; the first six
+ * slots are always reserved). Integral values are extended to 64 bits, a float
+ * on the stack occupies the right half of its slot.
+ *
+ * Structs of up to 16 bytes take one slot per 8-byte word: integral parts of
+ * a word go in the word's integer register, float fields at word offset 0/4 in
+ * %f<2j>/%f<2j+1>, double fields in %d<2j>. Larger structs are passed by
+ * reference to a copy. Unions are passed as integral words. Arguments to the
+ * variable part of a variadic function are passed as integral words.
+ *
+ * Results are returned in %o0 / %f0 (%d0). Structs of up to 32 bytes are
+ * returned in %o0-%o3 and %f0-%f7 by the same per-word rules, larger ones in
+ * memory through an address passed as an implicit first argument.
+ */
+public class LinuxSparc64CallArranger {
+
+    private static final int STACK_SLOT_SIZE = 8;
+    private static final int MAX_INT_REGISTER_SLOTS = 6;
+    private static final int MAX_FLOAT_REGISTER_SLOTS = 16;
+    private static final long MAX_REGISTER_ARGUMENT_STRUCT_SIZE = 16;
+    private static final long MAX_REGISTER_RETURN_STRUCT_SIZE = 32;
+
+    private static final VMStorage[] INT_ARG_REGS = { o0, o1, o2, o3, o4, o5 };
+
+    private static final ABIDescriptor CLinux = abiFor(
+            INT_ARG_REGS, // GP input
+            Regs.floatRegisters(), // FP input
+            new VMStorage[] { o0, o1, o2, o3 }, // GP output
+            new VMStorage[] { f(0), f(1), f(2), f(3), f(4), f(5), f(6), f(7) }, // FP output
+            new VMStorage[] { g1, g4, g5, o0, o1, o2, o3, o4, o5, o7 }, // volatile GP
+            new VMStorage[] {}, // volatile FP (excluding argument registers)
+            16, // %sp + BIAS is 16 byte aligned
+            176, // register window save area and the six reserved parameter slots
+            g1, g5 // scratch registers
+            );
+
+    public record Bindings(CallingSequence callingSequence, boolean isInMemoryReturn) {}
+
+    public static Bindings getBindings(MethodType mt, FunctionDescriptor cDesc, boolean forUpcall) {
+        return getBindings(mt, cDesc, forUpcall, LinkerOptions.empty());
+    }
+
+    public static Bindings getBindings(MethodType mt, FunctionDescriptor cDesc, boolean forUpcall, LinkerOptions options) {
+        CallingSequenceBuilder csb = new CallingSequenceBuilder(CLinux, forUpcall, options);
+
+        BindingCalculator argCalc = forUpcall ? new BoxBindingCalculator(true) : new UnboxBindingCalculator(true, options.allowsHeapAccess());
