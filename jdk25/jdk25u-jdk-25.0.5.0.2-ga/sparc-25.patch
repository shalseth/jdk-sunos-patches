+// holding the string are scanned with a carry-free equal-lane test, lanes
+// outside the string masked off, so a hit is never a false positive. Every
+// word read holds an element of the string, so it stays inside the array.
+void C2_MacroAssembler::string_indexof_char(Register str, Register cnt, Register ch, Register result,
+                                            Register pattern, Register mask, Register base, Register word,
+                                            Register hits, Register t1, bool is_byte) {
+  Label Lloop, Llast, Lfound, Lnot_found, Ldone;
+  assert_different_registers(str, cnt, ch, result, pattern, mask, base, word, hits, t1);
+  const Register end = result;   // address past the string
+
+  const int shift = is_byte ? 0 : 1;
