+  intptr_t* locals = derelativize(Llocals->sp_offset_in_saved_window());
+  if (locals + 1 >= _end) {
+    _unextended_sp = _end;
+    _sp = _end;
+  } else {
+    intptr_t* callers_sp = this->fp();
+    _sp = callers_sp;
