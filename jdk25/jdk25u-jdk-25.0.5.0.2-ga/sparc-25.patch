+            Class<?> carrier = mt.parameterType(i);
+            MemoryLayout layout = cDesc.argumentLayouts().get(i);
+            boolean variadic = options.isVariadicFunction() && i >= options.firstVariadicArgIndex();
+            csb.addArgumentBindings(carrier, layout, argCalc.getBindings(carrier, layout, variadic));
+        }
