+//---------------------------- continuation enter/yield ---------------------------
+//
+// enterSpecial's frame is the ContinuationEntry, which starts with the frame's
+// register window save area (ContinuationEntryPD).
+
+static void continuation_enter_setup(MacroAssembler* masm, int frame_size_in_bytes) {
+  __ save(SP, -frame_size_in_bytes, SP);
+  __ st_ptr(I7, SP, in_bytes(ContinuationEntryPD::return_pc_offset()) + STACK_BIAS);
+  // A c2i adapter below may move SP, and the window would then be spilled
+  // there; stack walks read FP and I7 at the entry.
+  __ st_ptr(FP, SP, FP->sp_offset_in_saved_window() * wordSize + STACK_BIAS);
+  __ st_ptr(I7, SP, I7->sp_offset_in_saved_window() * wordSize + STACK_BIAS);
+  __ ld_ptr(G2_thread, in_bytes(JavaThread::cont_entry_offset()), L0);
+  __ st_ptr(L0, SP, in_bytes(ContinuationEntry::parent_offset()) + STACK_BIAS);
+  __ add(SP, STACK_BIAS, L0);
+  __ st_ptr(L0, G2_thread, in_bytes(JavaThread::cont_entry_offset()));
+}
+
+// I0: the continuation, I2: isVirtualThread
+static void fill_continuation_entry(MacroAssembler* masm) {
+#ifdef ASSERT
+  __ set(ContinuationEntry::cookie_value(), L1);
+  __ stw(L1, SP, in_bytes(ContinuationEntry::cookie_offset()) + STACK_BIAS);
+#endif
+  __ st_ptr(I0, SP, in_bytes(ContinuationEntry::cont_offset()) + STACK_BIAS);
+  __ stw(I2, SP, in_bytes(ContinuationEntry::flags_offset()) + STACK_BIAS);
+  __ st_ptr(G0, SP, in_bytes(ContinuationEntry::chunk_offset()) + STACK_BIAS);
+  __ stw(G0, SP, in_bytes(ContinuationEntry::argsize_offset()) + STACK_BIAS);
+  __ stw(G0, SP, in_bytes(ContinuationEntry::pin_count_offset()) + STACK_BIAS);
+
+  __ ld_ptr(G2_thread, in_bytes(JavaThread::cont_fastpath_offset()), L1);
+  __ ldx(G2_thread, in_bytes(JavaThread::held_monitor_count_offset()), L2);
+  __ st_ptr(L1, SP, in_bytes(ContinuationEntry::parent_cont_fastpath_offset()) + STACK_BIAS);
+  __ stx(L2, SP, in_bytes(ContinuationEntry::parent_held_monitor_count_offset()) + STACK_BIAS);
+
+  __ st_ptr(G0, G2_thread, in_bytes(JavaThread::cont_fastpath_offset()));
+  __ stx(G0, G2_thread, in_bytes(JavaThread::held_monitor_count_offset()));
+}
+
+// Restore the thread's continuation state from the entry at base + bias.
+// Leaves O0 (return value or exception) alone.
+static void continuation_enter_cleanup(MacroAssembler* masm, Register base, int bias) {
+  __ ld_ptr(base, in_bytes(ContinuationEntry::parent_cont_fastpath_offset()) + bias, L1);
+  __ st_ptr(L1, G2_thread, in_bytes(JavaThread::cont_fastpath_offset()));
+
+  if (CheckJNICalls) {
+    // A terminating virtual thread that still holds a JNI monitor: log it as
+    // JavaThread::exit does, and clear the carrier's count.
+    Label L_skip;
+    __ lduw(base, in_bytes(ContinuationEntry::flags_offset()) + bias, L1);
+    __ br_null_short(L1, Assembler::pt, L_skip);
+    __ ldx(G2_thread, in_bytes(JavaThread::jni_monitor_count_offset()), L1);
+    __ br_null_short(L1, Assembler::pt, L_skip);
+    __ mov(O0, L4);
+    __ call_VM_leaf(L7_thread_cache, CAST_FROM_FN_PTR(address, SharedRuntime::log_jni_monitor_still_held));
+    __ mov(L4, O0);
+    __ stx(G0, G2_thread, in_bytes(JavaThread::jni_monitor_count_offset()));
+    __ bind(L_skip);
+  }
+
+#ifdef ASSERT
+  // The JNI monitor count of a terminating virtual thread is only used for
+  // assertions; the carrier's count is cleared.
+  Label L_skip_vthread_code;
+  __ lduw(base, in_bytes(ContinuationEntry::flags_offset()) + bias, L1);
+  __ br_null_short(L1, Assembler::pt, L_skip_vthread_code);
+  __ stx(G0, G2_thread, in_bytes(JavaThread::jni_monitor_count_offset()));
+  __ bind(L_skip_vthread_code);
+#endif
+
+  __ ldx(base, in_bytes(ContinuationEntry::parent_held_monitor_count_offset()) + bias, L2);
+  __ ld_ptr(base, in_bytes(ContinuationEntry::parent_offset()) + bias, L3);
+  __ stx(L2, G2_thread, in_bytes(JavaThread::held_monitor_count_offset()));
+  __ st_ptr(L3, G2_thread, in_bytes(JavaThread::cont_entry_offset()));
+}
+
+// L0: the entry
+void SharedRuntime::continuation_enter_cleanup(MacroAssembler* masm) {
+  __ ld_ptr(G2_thread, in_bytes(JavaThread::cont_entry_offset()), L0);
+  ::continuation_enter_cleanup(masm, L0, 0);
+}
