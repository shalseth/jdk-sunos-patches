+  brx(Assembler::zero, false, Assembler::pn, slow);
+  delayed()->xor3(mark, markWord::unlocked_value, top);
+  assert(oopDesc::mark_offset_in_bytes() == 0, "cas must take a zero displacement");
+  cas_ptr(obj, mark, top);
+  cmp(top, mark);
+  brx(Assembler::notEqual, false, Assembler::pn, slow);
+  delayed()->lduw(G2_thread, in_bytes(JavaThread::lock_stack_top_offset()), top);
+
+  bind(push);
+  stx(obj, G2_thread, top);
+  add(top, oopSize, top);
+  stw(top, G2_thread, in_bytes(JavaThread::lock_stack_top_offset()));
+}
+
+void MacroAssembler::lightweight_unlock(Register obj, Register t1, Register t2, Label& slow) {
+  check_lock_stack_offsets();
+  assert(LockingMode == LM_LIGHTWEIGHT, "only used with new lightweight locking");
+  assert_different_registers(obj, t1, t2);
+  const Register top = t1;
+  const Register mark = t2;
+  Label unlocked, push_and_slow;
+
+  lduw(G2_thread, in_bytes(JavaThread::lock_stack_top_offset()), top);
+  sub(top, oopSize, top);
+  ldx(G2_thread, top, mark);
+  cmp(obj, mark);
+  brx(Assembler::notEqual, false, Assembler::pn, slow);
+  delayed()->nop();
+
+  stw(top, G2_thread, in_bytes(JavaThread::lock_stack_top_offset()));
+  DEBUG_ONLY(stx(G0, G2_thread, top);)
+  sub(top, oopSize, mark);
+  ldx(G2_thread, mark, mark);
+  cmp(obj, mark);
+  brx(Assembler::equal, false, Assembler::pn, unlocked);
+  delayed()->nop();
+
+  ld_ptr(obj, oopDesc::mark_offset_in_bytes(), mark);
+  btst(markWord::monitor_value, mark);
+  brx(Assembler::notZero, false, Assembler::pn, push_and_slow);
+  delayed()->or3(mark, markWord::unlocked_value, top);
+  cas_ptr(obj, mark, top);
+  cmp(top, mark);
+  brx(Assembler::equal, false, Assembler::pt, unlocked);
+  delayed()->nop();
+
+  bind(push_and_slow);
+  lduw(G2_thread, in_bytes(JavaThread::lock_stack_top_offset()), top);
+  DEBUG_ONLY(stx(obj, G2_thread, top);)
+  add(top, oopSize, top);
+  ba(slow);
+  delayed()->stw(top, G2_thread, in_bytes(JavaThread::lock_stack_top_offset()));
+
+  bind(unlocked);
+}
+
+// C2 and native wrapper fast paths: xcc/icc EQ on success, NE to take the slow path.
+void MacroAssembler::compiler_fast_lock_lightweight_object(Register obj, Register t1, Register t2, Register t3) {
+  check_lock_stack_offsets();
+  assert_different_registers(obj, t1, t2, t3);
+  const Register mark = t1;
+  const Register top = t2;
+  const Register t = t3;
+  Label inflated, push, slow_path, done;
+
+  verify_oop(obj);
+
+  if (DiagnoseSyncOnValueBasedClasses != 0) {
+    load_klass(obj, t);
+    ldub(t, in_bytes(Klass::misc_flags_offset()), t);
+    btst(KlassFlags::_misc_is_value_based_class, t);
+    br(Assembler::notZero, false, Assembler::pn, slow_path);
+    delayed()->nop();
+  }
+
+  lduw(G2_thread, in_bytes(JavaThread::lock_stack_top_offset()), top);
+  cmp(top, LockStack::end_offset());
+  br(Assembler::greaterEqualUnsigned, false, Assembler::pn, slow_path);
+  delayed()->sub(top, oopSize, t);
+
+  ldx(G2_thread, t, t);
+  cmp(obj, t);
+  brx(Assembler::equal, false, Assembler::pn, push);
+  delayed()->nop();
+
+  ld_ptr(obj, oopDesc::mark_offset_in_bytes(), mark);
+  btst(markWord::monitor_value, mark);
+  brx(Assembler::notZero, false, Assembler::pn, inflated);
+  delayed()->btst(markWord::unlocked_value, mark);
+  brx(Assembler::zero, false, Assembler::pn, slow_path);
+  delayed()->xor3(mark, markWord::unlocked_value, t);
+  assert(oopDesc::mark_offset_in_bytes() == 0, "cas must take a zero displacement");
+  cas_ptr(obj, mark, t);
+  cmp(t, mark);
+  brx(Assembler::notEqual, false, Assembler::pn, slow_path);
+  delayed()->nop();
+
+  bind(push);
+  stx(obj, G2_thread, top);
+  add(top, oopSize, top);
+  stw(top, G2_thread, in_bytes(JavaThread::lock_stack_top_offset()));
+  ba(done);
+  delayed()->cmp(G0, G0);
+
+  bind(inflated);
+  // mark is the tagged ObjectMonitor*; top becomes the owner address.
+  add(mark, OM_OFFSET_NO_MONITOR_VALUE_TAG(owner), top);
+  ld_ptr(G2_thread, in_bytes(JavaThread::monitor_owner_id_offset()), t);
+  cas_ptr(top, G0, t);
+  cmp(t, G0);
+  brx(Assembler::equal, false, Assembler::pt, done);
+  delayed()->ld_ptr(G2_thread, in_bytes(JavaThread::monitor_owner_id_offset()), mark);
+  cmp(t, mark);
+  brx(Assembler::notEqual, false, Assembler::pn, slow_path);
+  delayed()->nop();
+  ld_ptr(top, in_bytes(ObjectMonitor::recursions_offset() - ObjectMonitor::owner_offset()), t);
+  add(t, 1, t);
+  st_ptr(t, top, in_bytes(ObjectMonitor::recursions_offset() - ObjectMonitor::owner_offset()));
+  ba(done);
+  delayed()->cmp(G0, G0);
+
+  bind(slow_path);
+  cmp(G0, 1);
+  bind(done);
+}
+
+void MacroAssembler::compiler_fast_unlock_lightweight_object(Register obj, Register t1, Register t2, Register t3) {
+  check_lock_stack_offsets();
+  assert_different_registers(obj, t1, t2, t3);
+  const Register mark = t1;
+  const Register top = t2;
+  const Register t = t3;
+  Label inflated, inflated_load_monitor, push_and_slow, not_recursive, unlocked, slow_path, done;
+
+  lduw(G2_thread, in_bytes(JavaThread::lock_stack_top_offset()), top);
+  sub(top, oopSize, top);
+  ldx(G2_thread, top, t);
+  cmp(obj, t);
+  brx(Assembler::notEqual, false, Assembler::pn, inflated_load_monitor);
+  delayed()->nop();
+
+  stw(top, G2_thread, in_bytes(JavaThread::lock_stack_top_offset()));
+  DEBUG_ONLY(stx(G0, G2_thread, top);)
+  sub(top, oopSize, t);
+  ldx(G2_thread, t, t);
+  cmp(obj, t);
+  brx(Assembler::equal, false, Assembler::pn, done);
+  delayed()->nop();
+
+  ld_ptr(obj, oopDesc::mark_offset_in_bytes(), mark);
+  btst(markWord::monitor_value, mark);
+  brx(Assembler::notZero, false, Assembler::pn, inflated);
+  delayed()->or3(mark, markWord::unlocked_value, t);
+  cas_ptr(obj, mark, t);
+  cmp(t, mark);
+  brx(Assembler::equal, false, Assembler::pt, done);
+  delayed()->nop();
+
+  bind(push_and_slow);
+  DEBUG_ONLY(stx(obj, G2_thread, top);)
+  add(top, oopSize, top);
+  ba(slow_path);
+  delayed()->stw(top, G2_thread, in_bytes(JavaThread::lock_stack_top_offset()));
+
+  bind(inflated_load_monitor);
+  ld_ptr(obj, oopDesc::mark_offset_in_bytes(), mark);
+
+  bind(inflated);
+  ld_ptr(mark, OM_OFFSET_NO_MONITOR_VALUE_TAG(recursions), t);
+  cmp(t, G0);
+  brx(Assembler::equal, false, Assembler::pt, not_recursive);
+  delayed()->sub(t, 1, t);
+  st_ptr(t, mark, OM_OFFSET_NO_MONITOR_VALUE_TAG(recursions));
+  ba(done);
+  delayed()->cmp(G0, G0);
+
+  bind(not_recursive);
+  // Release (TSO: plain store), then fence before looking for waiters.
+  st_ptr(G0, mark, OM_OFFSET_NO_MONITOR_VALUE_TAG(owner));
+  membar(StoreLoad);
+  ld_ptr(mark, OM_OFFSET_NO_MONITOR_VALUE_TAG(entry_list), t);
+  cmp(t, G0);
+  brx(Assembler::equal, false, Assembler::pt, done);
+  delayed()->nop();
+  ld_ptr(mark, OM_OFFSET_NO_MONITOR_VALUE_TAG(succ), t);
+  cmp(t, G0);
+  brx(Assembler::notEqual, false, Assembler::pt, unlocked);
+  delayed()->sub(mark, markWord::monitor_value, t);
+  // Waiters but no successor: let SharedRuntime::monitor_exit_helper reacquire.
+  ba(slow_path);
+  delayed()->st_ptr(t, G2_thread, in_bytes(JavaThread::unlocked_inflated_monitor_offset()));
+
+  bind(unlocked);
+  ba(done);
+  delayed()->cmp(G0, G0);
+
+  bind(slow_path);
+  cmp(G0, 1);
+  bind(done);
+}
+
+void MacroAssembler::push_cont_fastpath(Register tmp1, Register tmp2) {
+  if (!Continuations::enabled()) return;
+  Label done;
+  ld_ptr(G2_thread, in_bytes(JavaThread::cont_fastpath_offset()), tmp1);
+  add(SP, STACK_BIAS, tmp2);
+  cmp(tmp2, tmp1);
+  brx(Assembler::lessEqualUnsigned, false, Assembler::pt, done);
+  delayed()->nop();
+  st_ptr(tmp2, G2_thread, in_bytes(JavaThread::cont_fastpath_offset()));
+  bind(done);
+}
