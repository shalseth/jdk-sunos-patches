+  if (is_byte) {
+    and3(ch, 0xff, pattern);
+    sllx(pattern, 8, t1);
+    or3(pattern, t1, pattern);
+    set64(0x7f7f7f7f7f7f7f7fL, mask, t1);
+  } else {
+    sllx(ch, 48, pattern);
+    srlx(pattern, 48, pattern);
+    set64(0x7fff7fff7fff7fffL, mask, t1);
+  }
+  sllx(pattern, 16, t1);
+  or3(pattern, t1, pattern);
+  sllx(pattern, 32, t1);
+  or3(pattern, t1, pattern);
+  // Not the first instruction: the size of a leading cbcond depends on the previous node.
+  cmp_and_br_short(cnt, 0, Assembler::lessEqual, Assembler::pn, Lnot_found);
+
+  // Lanes equal to ch become zero in t = x ^ pattern; a lane is zero iff
+  // the high bit of ~(((t & m) + m) | t | m) is set (m = 0x7f..).
+  auto lane_hits = [&]() {
+    ldx(base, 0, word);
+    xor3(word, pattern, word);
+    and3(word, mask, hits);
+    add(hits, mask, hits);
+    or3(hits, word, hits);
+    or3(hits, mask, hits);
+    not1(hits);
+  };
