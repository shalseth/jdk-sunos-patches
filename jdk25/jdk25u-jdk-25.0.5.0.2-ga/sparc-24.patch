+source_hpp %{
+
+#include "gc/g1/c2/g1BarrierSetC2.hpp"
+#include "gc/shared/gc_globals.hpp"
+
+%}
+
+source %{
+
+#include "gc/g1/g1BarrierSetAssembler_sparc.hpp"
+#include "gc/g1/g1BarrierSetRuntime.hpp"
+
+// tmp1 and tmp2 must be global registers: the runtime call is made from a
+// new register window.
+static void write_barrier_pre(MacroAssembler* masm,
+                              const MachNode* node,
+                              Register obj,
+                              Register pre_val,
+                              Register tmp1,
+                              Register tmp2,
+                              Register preserve1 = noreg,
+                              Register preserve2 = noreg,
+                              Register preserve3 = noreg,
+                              Register no_preserve = noreg) {
+  if (!G1PreBarrierStubC2::needs_barrier(node)) {
+    return;
+  }
+  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
+  G1BarrierSetAssembler* g1_asm = static_cast<G1BarrierSetAssembler*>(BarrierSet::barrier_set()->barrier_set_assembler());
+  G1PreBarrierStubC2* const stub = G1PreBarrierStubC2::create(node);
+  Register preserve[] = { preserve1, preserve2, preserve3 };
+  for (Register r : preserve) {
+    if (r != noreg) {
+      stub->preserve(r);
+    }
+  }
+  if (no_preserve != noreg) {
+    stub->dont_preserve(no_preserve);
+  }
+  g1_asm->g1_write_barrier_pre_c2(masm, obj, pre_val, tmp1, tmp2, stub);
+}
+
+static void write_barrier_post(MacroAssembler* masm,
+                               const MachNode* node,
+                               Register store_addr,
+                               Register new_val,
+                               Register tmp1,
+                               Register tmp2,
+                               Register tmp3) {
+  if (!G1PostBarrierStubC2::needs_barrier(node)) {
+    return;
+  }
+  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
+  G1BarrierSetAssembler* g1_asm = static_cast<G1BarrierSetAssembler*>(BarrierSet::barrier_set()->barrier_set_assembler());
+  G1PostBarrierStubC2* const stub = G1PostBarrierStubC2::create(node);
+  g1_asm->g1_write_barrier_post_c2(masm, store_addr, new_val, tmp1, tmp2, tmp3, stub);
+}
+
+%}
+
+instruct g1StoreP(indirect mem, iRegP src, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_Store()->barrier_data() != 0);
+  match(Set mem (StoreP mem src));
+  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL ccr);
+  ins_cost(2 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "STX    $src,$mem\t! ptr (G1)" %}
+  ins_encode %{
+    Register mem = as_Register($mem$$base);
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $src$$Register /* preserve */);
+    __ stx($src$$Register, mem, 0);
+    write_barrier_post(masm, this,
+                       mem             /* store_addr */,
+                       $src$$Register  /* new_val */,
+                       $tmp1$$Register /* tmp1 */,
+                       $tmp2$$Register /* tmp2 */,
+                       $tmp3$$Register /* tmp3 */);
+  %}
+  ins_pipe(istore_mem_reg);
+%}
+
+instruct g1StoreN(indirect mem, iRegN src, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_Store()->barrier_data() != 0);
+  match(Set mem (StoreN mem src));
+  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL ccr);
+  ins_cost(2 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "STW    $src,$mem\t! compressed ptr (G1)" %}
+  ins_encode %{
+    Register mem = as_Register($mem$$base);
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $src$$Register /* preserve */);
+    __ stw($src$$Register, mem, 0);
+    if ((barrier_data() & G1C2BarrierPost) != 0) {
+      if ((barrier_data() & G1C2BarrierPostNotNull) == 0) {
+        __ decode_heap_oop($src$$Register, $tmp3$$Register);
+      } else {
+        __ decode_heap_oop_not_null($src$$Register, $tmp3$$Register);
+      }
+    }
+    write_barrier_post(masm, this,
+                       mem             /* store_addr */,
+                       $tmp3$$Register /* new_val */,
+                       $tmp1$$Register /* tmp1 */,
+                       $tmp2$$Register /* tmp2 */,
+                       $tmp3$$Register /* tmp3 */);
+  %}
+  ins_pipe(istore_mem_reg);
+%}
+
+instruct g1CompareAndSwapP(iRegP mem_ptr, iRegP oldval, iRegP newval, iRegI res, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, o7RegI tmp, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_LoadStore()->barrier_data() != 0);
+  match(Set res (CompareAndSwapP mem_ptr (Binary oldval newval)));
+  match(Set res (WeakCompareAndSwapP mem_ptr (Binary oldval newval)));
+  effect(USE mem_ptr, TEMP res, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL tmp, KILL ccr);
+  ins_cost(4 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "CASXA  [$mem_ptr],$oldval,$newval\t! ptr, $res = success (G1)" %}
+  ins_encode %{
+    Register mem = $mem_ptr$$Register;
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $oldval$$Register, $newval$$Register /* preserve */,
+                      $res$$Register /* no_preserve */);
+    __ mov($newval$$Register, O7);
+    __ casx(mem, $oldval$$Register, O7);
+    __ cmp($oldval$$Register, O7);
+    __ mov(1, $res$$Register);
+    __ movcc(Assembler::notEqual, false, Assembler::xcc, G0, $res$$Register);
+    write_barrier_post(masm, this,
+                       mem               /* store_addr */,
+                       $newval$$Register /* new_val */,
+                       $tmp1$$Register   /* tmp1 */,
+                       $tmp2$$Register   /* tmp2 */,
+                       $tmp3$$Register   /* tmp3 */);
+  %}
+  ins_pipe(long_memory_op);
+%}
+
+instruct g1CompareAndSwapN(iRegP mem_ptr, iRegN oldval, iRegN newval, iRegI res, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, o7RegI tmp, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_LoadStore()->barrier_data() != 0);
+  match(Set res (CompareAndSwapN mem_ptr (Binary oldval newval)));
+  match(Set res (WeakCompareAndSwapN mem_ptr (Binary oldval newval)));
+  effect(USE mem_ptr, TEMP res, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL tmp, KILL ccr);
+  ins_cost(4 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "CASA   [$mem_ptr],$oldval,$newval\t! compressed ptr, $res = success (G1)" %}
+  ins_encode %{
+    Register mem = $mem_ptr$$Register;
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $oldval$$Register, $newval$$Register /* preserve */,
+                      $res$$Register /* no_preserve */);
+    __ mov($newval$$Register, O7);
+    __ cas(mem, $oldval$$Register, O7);
+    __ cmp($oldval$$Register, O7);
+    __ mov(1, $res$$Register);
+    __ movcc(Assembler::notEqual, false, Assembler::icc, G0, $res$$Register);
+    if ((barrier_data() & G1C2BarrierPost) != 0) {
+      __ decode_heap_oop($newval$$Register, $tmp3$$Register);
+    }
+    write_barrier_post(masm, this,
+                       mem             /* store_addr */,
+                       $tmp3$$Register /* new_val */,
+                       $tmp1$$Register /* tmp1 */,
+                       $tmp2$$Register /* tmp2 */,
+                       $tmp3$$Register /* tmp3 */);
+  %}
+  ins_pipe(long_memory_op);
+%}
+
+instruct g1CompareAndExchangeP(iRegP mem_ptr, iRegP oldval, iRegP newval, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_LoadStore()->barrier_data() != 0);
+  match(Set newval (CompareAndExchangeP mem_ptr (Binary oldval newval)));
+  effect(USE mem_ptr, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL ccr);
+  ins_cost(4 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "CASXA  [$mem_ptr],$oldval,$newval\t! ptr (G1)" %}
+  ins_encode %{
+    Register mem = $mem_ptr$$Register;
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $oldval$$Register, $newval$$Register /* preserve */);
+    // newval is overwritten with the old value; keep the new one for the post barrier.
+    __ mov($newval$$Register, $tmp3$$Register);
+    __ casx(mem, $oldval$$Register, $newval$$Register);
+    write_barrier_post(masm, this,
+                       mem             /* store_addr */,
+                       $tmp3$$Register /* new_val */,
+                       $tmp1$$Register /* tmp1 */,
+                       $tmp2$$Register /* tmp2 */,
+                       $tmp3$$Register /* tmp3 */);
+  %}
+  ins_pipe(long_memory_op);
+%}
+
+instruct g1CompareAndExchangeN(iRegP mem_ptr, iRegN oldval, iRegN newval, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_LoadStore()->barrier_data() != 0);
+  match(Set newval (CompareAndExchangeN mem_ptr (Binary oldval newval)));
+  effect(USE mem_ptr, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL ccr);
+  ins_cost(4 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "CASA   [$mem_ptr],$oldval,$newval\t! compressed ptr (G1)" %}
+  ins_encode %{
+    Register mem = $mem_ptr$$Register;
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $oldval$$Register, $newval$$Register /* preserve */);
+    // newval is overwritten with the old value; keep the new one for the post barrier.
+    __ decode_heap_oop($newval$$Register, $tmp3$$Register);
+    __ cas(mem, $oldval$$Register, $newval$$Register);
+    write_barrier_post(masm, this,
+                       mem             /* store_addr */,
+                       $tmp3$$Register /* new_val */,
+                       $tmp1$$Register /* tmp1 */,
+                       $tmp2$$Register /* tmp2 */,
+                       $tmp3$$Register /* tmp3 */);
+  %}
+  ins_pipe(long_memory_op);
+%}
+
+instruct g1GetAndSetN(indirect mem, iRegN newval, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_LoadStore()->barrier_data() != 0);
+  match(Set newval (GetAndSetN mem newval));
+  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL ccr);
+  ins_cost(4 * (MEMORY_REF_COST + BRANCH_COST));
+  format %{ "SWAP   [$mem],$newval\t! compressed ptr (G1)" %}
+  ins_encode %{
+    Register mem = as_Register($mem$$base);
+    write_barrier_pre(masm, this,
+                      mem             /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */,
+                      mem, $newval$$Register /* preserve */);
+    // newval is overwritten with the old value; keep the new one for the post barrier.
+    __ decode_heap_oop($newval$$Register, $tmp3$$Register);
+    __ swap(Address(mem, 0), $newval$$Register);
+    write_barrier_post(masm, this,
+                       mem             /* store_addr */,
+                       $tmp3$$Register /* new_val */,
+                       $tmp1$$Register /* tmp1 */,
+                       $tmp2$$Register /* tmp2 */,
+                       $tmp3$$Register /* tmp3 */);
+  %}
+  ins_pipe(long_memory_op);
+%}
+
+instruct g1LoadP(iRegP dst, indirect mem, g1RegP tmp1, g3RegP tmp2, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_Load()->barrier_data() != 0);
+  match(Set dst (LoadP mem));
+  effect(TEMP dst, TEMP tmp1, TEMP tmp2, KILL ccr);
+  ins_cost(MEMORY_REF_COST + BRANCH_COST);
+  format %{ "LDX    $mem,$dst\t! ptr (G1)" %}
+  ins_encode %{
+    __ ldx(as_Register($mem$$base), 0, $dst$$Register);
+    write_barrier_pre(masm, this,
+                      noreg           /* obj */,
+                      $dst$$Register  /* pre_val */,
+                      $tmp1$$Register /* tmp1 */,
+                      $tmp2$$Register /* tmp2 */);
+  %}
+  ins_pipe(iload_mem);
+%}
+
+instruct g1LoadN(iRegN dst, indirect mem, g1RegP tmp1, g3RegP tmp2, g4RegP tmp3, flagsReg ccr)
+%{
+  predicate(UseG1GC && n->as_Load()->barrier_data() != 0);
+  match(Set dst (LoadN mem));
+  effect(TEMP dst, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL ccr);
+  ins_cost(MEMORY_REF_COST + BRANCH_COST);
+  format %{ "LDUW   $mem,$dst\t! compressed ptr (G1)" %}
+  ins_encode %{
+    __ lduw(as_Register($mem$$base), 0, $dst$$Register);
+    if ((barrier_data() & G1C2BarrierPre) != 0) {
+      __ decode_heap_oop($dst$$Register, $tmp1$$Register);
+    }
+    write_barrier_pre(masm, this,
+                      noreg           /* obj */,
+                      $tmp1$$Register /* pre_val */,
+                      $tmp2$$Register /* tmp1 */,
+                      $tmp3$$Register /* tmp2 */);
+  %}
+  ins_pipe(iload_mem);
+%}
