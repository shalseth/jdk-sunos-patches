+// The runtime is called from a new register window, which keeps the %o, %l
+// and %i registers of the compiled frame. Only live globals and float
+// registers have to be saved around the call.
+static void generate_c2_barrier_runtime_call(MacroAssembler* masm, G1BarrierStubC2* stub,
+                                             Register arg, address runtime_path) {
+  assert(arg->is_global() || arg->is_out(), "must be visible after the save");
+  static const int n_globals = 4;
+  const Register globals[n_globals] = { G1, G3, G4, G5 };
+  const int n_doubles = FloatRegisterImpl::number_of_registers / 2;
+  const int global_slot = frame::memory_parameter_word_sp_offset;
+  const int double_slot = global_slot + n_globals;
+  const int frame_words = align_up(double_slot + n_doubles, 2);
+
+  bool save_global[n_globals] = { false };
+  bool save_double[n_doubles] = { false };
+  RegMaskIterator rmi(stub->preserve_set());
+  while (rmi.has_next()) {
+    const VMReg vm_reg = OptoReg::as_VMReg(rmi.next());
+    if (vm_reg->is_Register()) {
+      Register r = as_Register(vm_reg->value() >> 1);
+      for (int i = 0; i < n_globals; i++) {
+        if (r == globals[i]) {
+          save_global[i] = true;
+        }
+      }
+    } else if (vm_reg->is_FloatRegister()) {
+      save_double[(vm_reg->value() - ConcreteRegisterImpl::max_gpr) / 2] = true;
+    }
+  }
+
+  __ save(SP, -frame_words * wordSize, SP);
+  for (int i = 0; i < n_globals; i++) {
+    if (save_global[i]) {
+      __ stx(globals[i], SP, STACK_BIAS + (global_slot + i) * wordSize);
+    }
+  }
+  for (int i = 0; i < n_doubles; i++) {
+    if (save_double[i]) {
+      __ stf(FloatRegisterImpl::D, as_FloatRegister(2 * i), SP, STACK_BIAS + (double_slot + i) * wordSize);
+    }
+  }
+  __ call_VM_leaf(L7_thread_cache, runtime_path, arg->after_save(), G2_thread);
+  for (int i = 0; i < n_doubles; i++) {
+    if (save_double[i]) {
+      __ ldf(FloatRegisterImpl::D, SP, STACK_BIAS + (double_slot + i) * wordSize, as_FloatRegister(2 * i));
+    }
+  }
+  for (int i = 0; i < n_globals; i++) {
+    if (save_global[i]) {
+      __ ldx(SP, STACK_BIAS + (global_slot + i) * wordSize, globals[i]);
+    }
+  }
+  __ restore();
+}
+
+void G1BarrierSetAssembler::g1_write_barrier_pre_c2(MacroAssembler* masm,
+                                                    Register obj,
+                                                    Register pre_val,
+                                                    Register tmp1,
+                                                    Register tmp2,
+                                                    G1PreBarrierStubC2* stub) {
+  assert_different_registers(obj, pre_val, tmp1, tmp2);
+  assert(tmp1->is_global() && tmp2->is_global(), "used after the save");
+
+  stub->initialize_registers(obj, pre_val, G2_thread, tmp1, tmp2);
+
+  // Is marking active?
+  if (in_bytes(SATBMarkQueue::byte_width_of_active()) == 4) {
+    __ ld(G2_thread, in_bytes(G1ThreadLocalData::satb_mark_queue_active_offset()), tmp1);
+  } else {
+    guarantee(in_bytes(SATBMarkQueue::byte_width_of_active()) == 1, "Assumption");
+    __ ldsb(G2_thread, in_bytes(G1ThreadLocalData::satb_mark_queue_active_offset()), tmp1);
+  }
+  __ cmp(tmp1, G0);
+  __ br(Assembler::notEqual, false, Assembler::pn, *stub->entry());
+  __ delayed()->nop();
+
+  __ bind(*stub->continuation());
+}
+
+void G1BarrierSetAssembler::generate_c2_pre_barrier_stub(MacroAssembler* masm,
+                                                         G1PreBarrierStubC2* stub) const {
+  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
+  Label runtime;
+  Register obj     = stub->obj();
+  Register pre_val = stub->pre_val();
+  Register tmp1    = stub->tmp1();
+  Register tmp2    = stub->tmp2();
+
+  __ bind(*stub->entry());
+
+  if (obj != noreg) {
+    __ load_heap_oop(obj, 0, pre_val, noreg, AS_RAW);
+  }
+  __ cmp(pre_val, G0);
+  __ brx(Assembler::equal, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+
+  // Can we store the value in the thread's SATB buffer?
+  int index_offset  = in_bytes(G1ThreadLocalData::satb_mark_queue_index_offset());
+  int buffer_offset = in_bytes(G1ThreadLocalData::satb_mark_queue_buffer_offset());
+  __ ld_ptr(G2_thread, index_offset, tmp1);
+  __ cmp(tmp1, G0);
+  __ brx(Assembler::equal, false, Assembler::pn, runtime);
+  __ delayed()->nop();
+  __ sub(tmp1, wordSize, tmp1);
+  __ st_ptr(tmp1, G2_thread, index_offset);
+  __ ld_ptr(G2_thread, buffer_offset, tmp2);
+  __ st_ptr(pre_val, tmp2, tmp1);
+  __ br(Assembler::always, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+
+  __ bind(runtime);
+  Register arg = pre_val;
+  if (!(arg->is_global() || arg->is_out())) {
+    __ mov(pre_val, tmp1);
+    arg = tmp1;
+  }
+  generate_c2_barrier_runtime_call(masm, stub, arg, CAST_FROM_FN_PTR(address, G1BarrierSetRuntime::write_ref_field_pre_entry));
+  __ br(Assembler::always, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+}
+
+void G1BarrierSetAssembler::g1_write_barrier_post_c2(MacroAssembler* masm,
+                                                     Register store_addr,
+                                                     Register new_val,
+                                                     Register tmp1,
+                                                     Register tmp2,
+                                                     Register tmp3,
+                                                     G1PostBarrierStubC2* stub) {
+  assert_different_registers(store_addr, new_val, tmp1, tmp2);
+  assert(tmp1->is_global() && tmp2->is_global() && tmp3->is_global(), "used after the save");
+
+  stub->initialize_registers(G2_thread, tmp1, tmp2, tmp3);
+
+  // Does store cross heap regions?
+  __ xor3(store_addr, new_val, tmp1);
+  __ srlx(tmp1, G1HeapRegion::LogOfHRGrainBytes, tmp1);
+  __ cmp(tmp1, G0);
+  __ brx(Assembler::equal, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+
+  // Crosses regions, storing null?
+  if ((stub->barrier_data() & G1C2BarrierPostNotNull) == 0) {
+    __ cmp(new_val, G0);
+    __ brx(Assembler::equal, false, Assembler::pt, *stub->continuation());
+    __ delayed()->nop();
+  }
+
+  // From here on, tmp1 holds the card address.
+  CardTableBarrierSet* ct = barrier_set_cast<CardTableBarrierSet>(BarrierSet::barrier_set());
+  __ srlx(store_addr, CardTable::card_shift(), tmp1);
+  __ set((intptr_t)ct->card_table()->byte_map_base(), tmp2);
+  __ add(tmp1, tmp2, tmp1);
+  __ ldub(tmp1, 0, tmp2);
+  __ cmp(tmp2, (int)G1CardTable::g1_young_card_val());
+  __ br(Assembler::notEqual, false, Assembler::pn, *stub->entry());
+  __ delayed()->nop();
+
+  __ bind(*stub->continuation());
+}
+
+void G1BarrierSetAssembler::generate_c2_post_barrier_stub(MacroAssembler* masm,
+                                                          G1PostBarrierStubC2* stub) const {
+  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
+  Label runtime;
+  Register card_addr = stub->tmp1();
+  Register tmp2      = stub->tmp2();
+  Register tmp3      = stub->tmp3();
+
+  __ bind(*stub->entry());
+
+  __ membar(Assembler::Membar_mask_bits(Assembler::StoreLoad));
+  STATIC_ASSERT(CardTable::dirty_card_val() == 0);
+  __ ldub(card_addr, 0, tmp2);
+  __ cmp(tmp2, G0);
+  __ br(Assembler::equal, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+  __ stb(G0, card_addr, 0);
+
+  // Can we store the card address in the thread's dirty card queue?
+  int index_offset  = in_bytes(G1ThreadLocalData::dirty_card_queue_index_offset());
+  int buffer_offset = in_bytes(G1ThreadLocalData::dirty_card_queue_buffer_offset());
+  __ ld_ptr(G2_thread, index_offset, tmp2);
+  __ cmp(tmp2, G0);
+  __ brx(Assembler::equal, false, Assembler::pn, runtime);
+  __ delayed()->nop();
+  __ sub(tmp2, wordSize, tmp2);
+  __ st_ptr(tmp2, G2_thread, index_offset);
+  __ ld_ptr(G2_thread, buffer_offset, tmp3);
+  __ st_ptr(card_addr, tmp3, tmp2);
+  __ br(Assembler::always, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+
+  __ bind(runtime);
+  generate_c2_barrier_runtime_call(masm, stub, card_addr, CAST_FROM_FN_PTR(address, G1BarrierSetRuntime::write_ref_field_post_entry));
+  __ br(Assembler::always, false, Assembler::pt, *stub->continuation());
+  __ delayed()->nop();
+}
